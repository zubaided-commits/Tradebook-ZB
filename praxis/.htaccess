# Praxis-Kalender - Schutzeinstellungen (Apache / IONOS Webspace)

# 1. Immer HTTPS erzwingen
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# 2. Konfiguration, Datenbank und Doku nicht ausliefern
<FilesMatch "^(config\.php|config\.example\.php)$|\.(sqlite|sqlite-wal|sqlite-shm|db|log|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 3. Verzeichnis-Listing aus
Options -Indexes

# 4. Kopfzeilen
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
